# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The `api` service runs inside its own Docker container/network. If Langfuse is also
# running locally in Docker (e.g. its own docker-compose stack), `localhost` here resolves
# to the `api` container itself, not your host machine or the Langfuse container - traces
# will silently fail to send. Use `http://host.docker.internal:<port>` instead (Mac/Windows
# Docker Desktop), or put both stacks on the same Docker network and use the Langfuse
# container's service name.
LANGFUSE_BASE_URL=

# Base URL the agent service's `vector_search` tool calls to reach the search service.
# No prefix when pointing at the standalone search_service app (e.g. "http://localhost:8000");
# include "/api" when pointing at the combined `main.py` app instead - that's what
# docker-compose.yml's single `api` service runs, so this must have the "/api" suffix for
# `make up` to work out of the box.
SEARCH_SERVICE_URL=http://localhost:8000/api

# Base URL for the GROBID service used to parse full paper PDFs (search_service's
# /full-paper endpoint). docker-compose.yml sets this to http://grobid:8070 for the `api`
# container automatically. Only set this yourself when running the search service on the
# host against a standalone GROBID container (default: http://localhost:8070, GROBID's
# standard port - e.g. `docker compose up -d grobid`).
GROBID_URL=

# Which GROBID docker image docker-compose.yml's `grobid` service runs (read directly by
# `docker compose`, not passed into any container). Default (unset) is the lightweight
# rule-based image "0.8.2-crf" - much lower RAM, noticeably worse section/reference
# detection. Set to "0.8.2" for the full deep-learning variant instead (best parse quality,
# ~4GB RAM). Same REST API either way - just `docker compose up -d grobid` to switch.
GROBID_IMAGE_TAG=
